rules_version = '2';

// Rahmah Firestore security rules.
// Each user can read and write only their own data.
// Public/editorial collections are read-only for everyone.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /userProgress/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    match /journals/{uid}/entries/{entryId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.text is string
        && request.resource.data.text.size() < 50000;
      allow delete: if isOwner(uid);
    }

    match /dzikirLogs/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    match /bookmarks/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    match /tanyaHistories/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 40;
      allow delete: if isOwner(uid);
    }

    match /reflections/{date} {
      allow read: if true;
      allow write: if false;
    }

    match /lessons/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
